# =========================================================
# AI Research Chatbot - Environment Variables
# =========================================================

# Groq API Key (Required - get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (Optional, defaults to llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# Secret Key for Flask session security (Change for production)
SECRET_KEY=generate_a_random_secure_secret_key_here

# Port (Used on Render or local running, defaults to 5000)
PORT=5000

# Flask debug mode (set to false in production)
FLASK_DEBUG=false
